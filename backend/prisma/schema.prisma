generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String                   @map("password_hash")
  role                    UserRole                 @default(patient)
  emailVerified           Boolean                  @default(false) @map("email_verified")
  phoneVerified           Boolean                  @default(false) @map("phone_verified")
  mfaEnabled              Boolean                  @default(false) @map("mfa_enabled")
  mfaSecret               String?                  @map("mfa_secret")
  isActive                Boolean                  @default(true) @map("is_active")
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until")
  /// Set when the account was erased (CS-23): login and contact details are gone.
  erasedAt                DateTime?                @map("erased_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  auditLogs               AuditLog[]
  sessions                AuthSession[]
  clinicianProfile        ClinicianProfile?
  emailVerificationTokens EmailVerificationToken[]
  mfaCodes                MfaCode[]
  mfaVerifications        MfaVerification[]
  notificationHistory     NotificationHistory[]
  notificationPreferences NotificationPreference?
  operatorProfile         OperatorProfile?
  passwordResetTokens     PasswordResetToken[]
  patientProfile          PatientProfile?
  pushTokens              PushToken[]
  savedPaymentMethods     SavedPaymentMethod[]
  scheduledNotifications  ScheduledNotification[]
  erasureRequests         ErasureRequest[]         @relation("ErasureRequestUser")
  erasureRequestsHandled  ErasureRequest[]         @relation("ErasureRequestHandler")
  messageThreads          MessageThread[]
  financingApplications   FinancingApplication[]
  rewardRedemptions       RewardRedemption[]
  rewardPointsAwards      RewardPointsAward[]
  referralCode            ReferralCode?
  referralsMade           Referral[]               @relation("Referrer")
  referredBy              Referral?                @relation("Referred")
  referralVouchersUsed    Referral[]               @relation("ReferralVoucherUsedBy")
  oralHealthMetric        OralHealthMetric?
  waitlistEntries         WaitlistEntry[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddressHash    String?   @map("ip_address_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model MfaCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String
  /// What the code is for (login, phone_login, mfa_step_up). A code only verifies its own purpose.
  purpose   String?
  /// Wrong guesses against this code; it's burned at the limit (CS-08, OT-2).
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("mfa_codes")
}

model MfaVerification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  verifiedAt DateTime @map("verified_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("mfa_verifications")
}

model PatientProfile {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @unique @map("user_id") @db.Uuid
  firstName             String              @map("first_name")
  lastName              String              @map("last_name")
  dob                   DateTime?           @db.Date
  gender                String?
  emergencyContactName  String?             @map("emergency_contact_name")
  emergencyContactPhone String?             @map("emergency_contact_phone")
  addressLine1          String?             @map("address_line1")
  addressLine2          String?             @map("address_line2")
  city                  String?
  postcode              String?
  medicalHistory        Json?               @map("medical_history")
  consents              Json?
  stripeCustomerId      String?             @unique @map("stripe_customer_id") @db.VarChar(100)
  /// Set when the patient was erased. The clinical record is kept until retainUntil.
  erasedAt              DateTime?           @map("erased_at")
  retainUntil           DateTime?           @map("retain_until") @db.Date
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  appointments          Appointment[]
  consentRecords        ConsentRecord[]
  documents             DocumentVault[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  odontogramTeeth       ToothRecord[]
  treatmentPlans        TreatmentPlan[]
  vanRequests           VanServiceRequest[]
  guardianDependants    Dependant[]         @relation("GuardianDependants")
  toothHistory          ToothHistory[]
  appointmentNotes      AppointmentNote[]

  @@index([postcode])
  @@index([createdAt])
  @@map("patient_profiles")
}

model ClinicianProfile {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @map("user_id") @db.Uuid
  fullName           String                  @map("full_name")
  gdcNumber          String                  @unique @map("gdc_number") @db.VarChar(6)
  roleTitle          String                  @map("role_title")
  specialisms        String[]
  bio                String?
  photoUrl           String?                 @map("photo_url")
  isTelehealthActive Boolean                 @default(true) @map("is_telehealth_active")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  appointments       Appointment[]
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions      Prescription[]
  treatmentPlans     TreatmentPlan[]
  rota               ClinicianRotaBlock[]
  rotaOverrides      ClinicianRotaOverride[]
  appointmentNotes   AppointmentNote[]
  assignedThreads    MessageThread[]         @relation("ClinicianAssignedThreads")

  @@index([isTelehealthActive])
  @@map("clinician_profiles")
}

model Clinic {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String
  address        String
  postcode       String
  city           String
  phone          String
  /// Free-text summary shown to patients. Slots come from openingHours.
  operatingHours String                  @map("operating_hours")
  isActive       Boolean                 @default(true) @map("is_active")
  createdAt      DateTime                @default(now()) @map("created_at")
  appointments   Appointment[]
  openingHours   ClinicOpeningHours[]
  closures       ClinicClosure[]
  rotaBlocks     ClinicianRotaBlock[]
  rotaOverrides  ClinicianRotaOverride[]

  @@map("clinics")
}

// Opening hours and rota (decisions log #12). Times are minutes after
// midnight, Europe/London wall-clock time; weekday is 0 (Sunday) to 6.
// A weekday with no row is a closed day.
model ClinicOpeningHours {
  id           String @id @default(uuid()) @db.Uuid
  clinicId     String @map("clinic_id") @db.Uuid
  weekday      Int    @db.SmallInt
  opensMinute  Int    @map("opens_minute") @db.SmallInt
  closesMinute Int    @map("closes_minute") @db.SmallInt
  clinic       Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, weekday])
  @@map("clinic_opening_hours")
}

/// A day the clinic is shut outside its weekly hours, e.g. a bank holiday.
model ClinicClosure {
  id       String   @id @default(uuid()) @db.Uuid
  clinicId String   @map("clinic_id") @db.Uuid
  date     DateTime @db.Date
  reason   String?  @db.VarChar(200)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@map("clinic_closures")
}

/// A clinician's weekly working block. clinicId null: not tied to one clinic
/// (any clinic, video and van).
model ClinicianRotaBlock {
  id          String           @id @default(uuid()) @db.Uuid
  clinicianId String           @map("clinician_id") @db.Uuid
  clinicId    String?          @map("clinic_id") @db.Uuid
  weekday     Int              @db.SmallInt
  startMinute Int              @map("start_minute") @db.SmallInt
  endMinute   Int              @map("end_minute") @db.SmallInt
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  clinic      Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicianId, weekday, startMinute])
  @@index([clinicId])
  @@map("clinician_rota_blocks")
}

/// Replaces a clinician's weekly rota for one date. No times: not working.
model ClinicianRotaOverride {
  id          String           @id @default(uuid()) @db.Uuid
  clinicianId String           @map("clinician_id") @db.Uuid
  date        DateTime         @db.Date
  clinicId    String?          @map("clinic_id") @db.Uuid
  startMinute Int?             @map("start_minute") @db.SmallInt
  endMinute   Int?             @map("end_minute") @db.SmallInt
  reason      String?          @db.VarChar(200)
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  clinic      Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicianId, date])
  @@index([clinicId])
  @@map("clinician_rota_overrides")
}

model Van {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String
  registrationPlate String                  @unique @map("registration_plate")
  vehicleModel      String                  @map("vehicle_model")
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at")
  appointments      Appointment[]
  assignments       VanOperatorAssignment[]
  servicePolygons   VanServicePolygon[]
  vanRequests       VanServiceRequest[]
  shifts            VanShift[]

  @@index([isActive])
  @@map("vans")
}

model VanServicePolygon {
  id             String                                 @id @default(uuid()) @db.Uuid
  vanId          String                                 @map("van_id") @db.Uuid
  sectorName     String                                 @map("sector_name")
  polygonGeoJson Json                                   @map("polygon_geojson")
  /// PostGIS geometry derived from polygon_geojson by a DB trigger (see migration 20260921030000); never written by the app.
  polygon        Unsupported("geometry(Polygon,4326)")?
  createdAt      DateTime                               @default(now()) @map("created_at")
  van            Van                                    @relation(fields: [vanId], references: [id], onDelete: Cascade)

  @@index([vanId])
  @@index([sectorName])
  @@index([polygon], map: "idx_van_service_polygons_polygon", type: Gist)
  @@map("van_service_polygons")
}

model Service {
  id                   String              @id
  name                 String
  category             ServiceCategory
  description          String
  durationMinutes      Int                 @map("duration_minutes")
  pricePence           Int                 @map("price_pence")
  depositPence         Int                 @map("deposit_pence")
  supportedChannels    CareChannel[]       @map("supported_channels")
  prepInstructions     String[]            @map("prep_instructions")
  requiresPriorConsult Boolean             @default(false) @map("requires_prior_consult")
  isActive             Boolean             @default(true) @map("is_active")
  appointments         Appointment[]
  vanRequests          VanServiceRequest[]

  @@map("services")
}

model Appointment {
  id                   String             @id @default(uuid()) @db.Uuid
  patientId            String             @map("patient_id") @db.Uuid
  clinicianId          String?            @map("clinician_id") @db.Uuid
  serviceId            String             @map("service_id")
  channel              CareChannel
  clinicId             String?            @map("clinic_id") @db.Uuid
  vanId                String?            @map("van_id") @db.Uuid
  startTimeUtc         DateTime           @map("start_time_utc")
  endTimeUtc           DateTime           @map("end_time_utc")
  status               AppointmentStatus  @default(draft_hold)
  holdExpiresAt        DateTime?          @map("hold_expires_at")
  accessDetails        Json?              @map("access_details")
  triageData           Json?              @map("triage_data")
  intraoralPhotos      String[]           @map("intraoral_photos")
  totalPricePence      Int                @map("total_price_pence")
  depositPaidPence     Int                @default(0) @map("deposit_paid_pence")
  /// Taken off the service deposit by a rewards voucher when payment started.
  depositDiscountPence Int                @default(0) @map("deposit_discount_pence")
  stripePaymentId      String?            @map("stripe_payment_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  clinic               Clinic?            @relation(fields: [clinicId], references: [id])
  clinician            ClinicianProfile?  @relation(fields: [clinicianId], references: [id])
  patient              PatientProfile     @relation(fields: [patientId], references: [id])
  service              Service            @relation(fields: [serviceId], references: [id])
  van                  Van?               @relation(fields: [vanId], references: [id])
  prescriptions        Prescription[]
  vanServiceRequest    VanServiceRequest?
  /// Set when a guardian booked this visit for their child (decisions log #17).
  dependantId          String?            @map("dependant_id") @db.Uuid
  dependant            Dependant?         @relation(fields: [dependantId], references: [id], onDelete: Restrict)
  pointsAward          RewardPointsAward?
  rewardVoucher        RewardRedemption?
  referralQualified    Referral?
  appointmentNote      AppointmentNote?
  toothHistory         ToothHistory[]

  @@index([patientId])
  @@index([clinicianId])
  @@index([serviceId])
  @@index([startTimeUtc])
  @@index([status])
  @@index([holdExpiresAt])
  @@index([stripePaymentId])
  @@index([dependantId])
  @@map("appointments")
}

model ToothRecord {
  id          String         @id @default(uuid()) @db.Uuid
  patientId   String         @map("patient_id") @db.Uuid
  toothNumber Int            @map("tooth_number")
  arch        String
  quadrant    String
  condition   ToothCondition @default(healthy)
  notes       String?
  updatedAt   DateTime       @updatedAt @map("updated_at")
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, toothNumber])
  @@map("tooth_records")
}

model ToothHistory {
  id            BigInt         @id @default(autoincrement())
  patientId     String         @map("patient_id") @db.Uuid
  toothNumber   Int            @map("tooth_number")
  arch          String
  quadrant      String
  condition     ToothCondition
  notes         String?
  appointmentId String?        @map("appointment_id") @db.Uuid
  recordedBy    String?        @map("recorded_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, toothNumber])
  @@index([appointmentId])
  @@map("tooth_history")
}

model AppointmentNote {
  id            String           @id @default(uuid()) @db.Uuid
  appointmentId String           @unique @map("appointment_id") @db.Uuid
  clinicianId   String           @map("clinician_id") @db.Uuid
  patientId     String           @map("patient_id") @db.Uuid
  notes         String           @db.Text
  diagnosis     String?
  treatmentPlan String?          @map("treatment_plan")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinician     ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  patient       PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicianId])
  @@map("appointment_notes")
}

model TreatmentPlan {
  id               String              @id @default(uuid()) @db.Uuid
  patientId        String              @map("patient_id") @db.Uuid
  clinicianId      String              @map("clinician_id") @db.Uuid
  title            String
  status           String              @default("pending_acceptance")
  totalCostPence   Int                 @map("total_cost_pence")
  patientSignature String?             @map("patient_signature")
  patientSignedAt  DateTime?           @map("patient_signed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  items            TreatmentPlanItem[]
  clinician        ClinicianProfile    @relation(fields: [clinicianId], references: [id])
  patient          PatientProfile      @relation(fields: [patientId], references: [id])

  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id              String        @id @default(uuid()) @db.Uuid
  treatmentPlanId String        @map("treatment_plan_id") @db.Uuid
  code            String
  description     String
  toothNumber     Int?          @map("tooth_number")
  costPence       Int           @map("cost_pence")
  isAccepted      Boolean       @default(true) @map("is_accepted")
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@map("treatment_plan_items")
}

model Prescription {
  id                 String           @id @default(uuid()) @db.Uuid
  appointmentId      String?          @map("appointment_id") @db.Uuid
  clinicianId        String           @map("clinician_id") @db.Uuid
  medicationName     String           @map("medication_name")
  dosageInstructions String           @map("dosage_instructions")
  dispensingPharmacy String           @map("dispensing_pharmacy")
  /// Legacy: invented "NHS-EPS" references from before signed PDFs. No longer written.
  epsTransactionRef  String?          @map("eps_transaction_ref")
  dispatchedAt       DateTime?        @map("dispatched_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  /// Practice reference printed on the signed PDF (decisions log #4).
  reference          String?          @unique @db.VarChar(32)
  /// What was prescribed, for whom and by whom, frozen and signed at issue.
  content            Json?
  /// Ed25519 signature over the canonical JSON of content, base64.
  signature          String?
  signingKeyId       String?          @map("signing_key_id") @db.VarChar(64)
  appointment        Appointment?     @relation(fields: [appointmentId], references: [id])
  clinician          ClinicianProfile @relation(fields: [clinicianId], references: [id])

  @@index([appointmentId])
  @@index([clinicianId])
  @@index([dispatchedAt])
  @@index([createdAt])
  @@index([epsTransactionRef])
  @@map("prescriptions")
}

model DocumentVault {
  id            String         @id @default(uuid()) @db.Uuid
  patientId     String         @map("patient_id") @db.Uuid
  docType       String         @map("doc_type")
  title         String
  fileKey       String         @map("file_key")
  fileSizeBytes String         @map("file_size_bytes")
  createdAt     DateTime       @default(now()) @map("created_at")
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("document_vault")
}

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  action        String
  actorId       String?   @map("actor_id") @db.Uuid
  resourceId    String?   @map("resource_id")
  sessionId     String?   @map("session_id")
  ipHash        String?   @map("ip_hash")
  metadata      Json?
  integrityHash String?   @map("integrity_hash")
  timestampUtc  DateTime  @default(now()) @map("timestamp_utc")
  archived      Boolean   @default(false)
  archivedAt    DateTime? @map("archived_at")
  actor         User?     @relation(fields: [actorId], references: [id])

  @@index([timestampUtc])
  @@index([actorId])
  @@index([action])
  @@index([archived])
  @@index([archived, timestampUtc, id])
  @@map("audit_logs")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model NotificationPreference {
  userId                   String   @unique @map("user_id") @db.Uuid
  pushEnabled              Boolean  @default(true) @map("push_enabled")
  emailEnabled             Boolean  @default(true) @map("email_enabled")
  smsEnabled               Boolean  @default(false) @map("sms_enabled")
  appointmentReminders     Boolean  @default(true) @map("appointment_reminders")
  appointmentConfirmations Boolean  @default(true) @map("appointment_confirmations")
  marketingUpdates         Boolean  @default(false) @map("marketing_updates")
  quietHoursStart          String   @default("22:00") @map("quiet_hours_start")
  quietHoursEnd            String   @default("08:00") @map("quiet_hours_end")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ConsentRecord {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  consentType      String         @map("consent_type")
  version          Int            @default(1)
  lawfulBasis      String         @map("lawful_basis")
  isGranted        Boolean        @default(true) @map("is_granted")
  grantedAt        DateTime       @default(now()) @map("granted_at")
  withdrawnAt      DateTime?      @map("withdrawn_at")
  ipAddress        String?        @map("ip_address")
  metadata         Json?
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([patientProfileId, consentType, version])
  @@index([patientProfileId])
  @@index([consentType])
  @@map("consent_records")
}

/// Family member managed under a guardian's patient account.
model Dependant {
  id            String         @id @default(uuid()) @db.Uuid
  guardianId    String         @map("guardian_id") @db.Uuid
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(100)
  /// ISO date string (YYYY-MM-DD) — dependants may not have full profiles
  dob           String         @db.VarChar(10)
  relationship  String         @db.VarChar(20)
  consentSigned Boolean        @default(false) @map("consent_signed")
  createdAt     DateTime       @default(now()) @map("created_at")
  guardian      PatientProfile @relation("GuardianDependants", fields: [guardianId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([guardianId])
  @@map("dependants")
}

/// Priority queue for patients waiting for a cancelled slot to reopen.
model WaitlistEntry {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  serviceId     String    @map("service_id")
  preferredDate String    @map("preferred_date") @db.VarChar(10)
  position      Int
  joinedAt      DateTime  @default(now()) @map("joined_at")
  claimedAt     DateTime? @map("claimed_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([serviceId, preferredDate, userId])
  @@index([serviceId, preferredDate, position])
  @@map("waitlist_entries")
}

model ScheduledNotification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  title        String
  body         String
  data         Json?
  scheduledFor DateTime  @map("scheduled_for")
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  sentAt       DateTime? @map("sent_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("scheduled_notifications")
}

model NotificationHistory {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  type   String
  title  String
  body   String
  data   Json?
  sentAt DateTime @default(now()) @map("sent_at")
  status String   @default("sent")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_history")
}

model SavedPaymentMethod {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  stripePaymentMethodId String   @unique @map("stripe_payment_method_id") @db.VarChar(100)
  brand                 String   @db.VarChar(30)
  last4                 String   @db.VarChar(4)
  expMonth              Int      @map("exp_month")
  expYear               Int      @map("exp_year")
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_payment_methods")
}

/// Deduplication log of processed Stripe webhook events (CS-17, WH-3, BJ-4)
model ProcessedStripeEvent {
  id        String   @id @db.VarChar(255)
  type      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

model OperatorProfile {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @unique @map("user_id") @db.Uuid
  fullName    String                  @map("full_name") @db.VarChar(100)
  phone       String?                 @db.VarChar(20)
  photoUrl    String?                 @map("photo_url") @db.VarChar(500)
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments VanOperatorAssignment[]
  shifts      VanShift[]

  @@map("operator_profiles")
}

model VanOperatorAssignment {
  id         String          @id @default(uuid()) @db.Uuid
  operatorId String          @map("operator_id") @db.Uuid
  vanId      String          @map("van_id") @db.Uuid
  startsAt   DateTime        @map("starts_at")
  endsAt     DateTime?       @map("ends_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  operator   OperatorProfile @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  van        Van             @relation(fields: [vanId], references: [id], onDelete: Cascade)

  @@index([operatorId, startsAt])
  @@index([vanId, startsAt])
  @@map("van_operator_assignments")
}

/// One row per shift-on session
model VanShift {
  id             String              @id @default(uuid()) @db.Uuid
  vanId          String              @map("van_id") @db.Uuid
  operatorId     String              @map("operator_id") @db.Uuid
  status         VanShiftStatus      @default(online)
  startedAt      DateTime            @default(now()) @map("started_at")
  endedAt        DateTime?           @map("ended_at")
  lastLat        Float?              @map("last_lat")
  lastLng        Float?              @map("last_lng")
  lastLocationAt DateTime?           @map("last_location_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  locations      VanLocationPing[]
  requests       VanServiceRequest[]
  operator       OperatorProfile     @relation(fields: [operatorId], references: [id])
  van            Van                 @relation(fields: [vanId], references: [id])

  @@index([vanId, status])
  @@index([operatorId, status])
  // Also partial unique indexes on operator_id and van_id WHERE ended_at IS
  // NULL (migrations 20261024030000/030100); Prisma can't declare them.
  @@map("van_shifts")
}

model VanLocationPing {
  id         String   @id @default(uuid()) @db.Uuid
  shiftId    String   @map("shift_id") @db.Uuid
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  recordedAt DateTime @default(now()) @map("recorded_at")
  shift      VanShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, recordedAt])
  @@map("van_location_pings")
}

/// Patient request + live queue item
model VanServiceRequest {
  id                  String           @id @default(uuid()) @db.Uuid
  shiftId             String           @map("shift_id") @db.Uuid
  vanId               String           @map("van_id") @db.Uuid
  patientId           String           @map("patient_id") @db.Uuid
  serviceId           String           @map("service_id")
  status              VanRequestStatus @default(pending)
  phase               VanStopPhase     @default(queued)
  queuePosition       Int?             @map("queue_position")
  patientLat          Float            @map("patient_lat")
  patientLng          Float            @map("patient_lng")
  accessDetails       Json             @map("access_details")
  requestedAt         DateTime         @default(now()) @map("requested_at")
  expiresAt           DateTime         @map("expires_at")
  acceptedAt          DateTime?        @map("accepted_at")
  treatmentStartedAt  DateTime?        @map("treatment_started_at")
  completedAt         DateTime?        @map("completed_at")
  etaSecondsSnapshot  Int?             @map("eta_seconds_snapshot")
  appointmentId       String?          @unique @map("appointment_id") @db.Uuid
  paymentIntentId     String?          @map("payment_intent_id")
  depositAuthorizedAt DateTime?        @map("deposit_authorized_at")
  depositReleaseStatus String?         @map("deposit_release_status") @db.VarChar(50)
  depositReleasedAt    DateTime?       @map("deposit_released_at")
  /// Last ETA pushed to the patient (drives material-delta gating)
  lastEtaSeconds      Int?             @map("last_eta_seconds")
  lastEtaPushedAt     DateTime?        @map("last_eta_pushed_at")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  appointment         Appointment?     @relation(fields: [appointmentId], references: [id])
  patient             PatientProfile   @relation(fields: [patientId], references: [id])
  service             Service          @relation(fields: [serviceId], references: [id])
  shift               VanShift         @relation(fields: [shiftId], references: [id])
  van                 Van              @relation(fields: [vanId], references: [id])

  @@index([shiftId, status])
  @@index([vanId, status])
  @@index([patientId, status])
  @@index([shiftId, queuePosition])
  @@index([status, depositReleaseStatus])
  // Also a partial unique index on patient_id for open requests (migration
  // 20261024030200); Prisma can't declare it.
  @@map("van_service_requests")
}

/// Secure patient-clinician messaging thread
model MessageThread {
  id                  String            @id @default(uuid()) @db.Uuid
  patientUserId       String            @map("patient_user_id") @db.Uuid
  senderName          String            @map("sender_name") @db.VarChar(150)
  subject             String
  preview             String
  isRead              Boolean           @default(false) @map("is_read")
  /// Per-side unread flags (CS-29). is_read is still written for older clients.
  patientUnread       Boolean           @default(false) @map("patient_unread")
  staffUnread         Boolean           @default(false) @map("staff_unread")
  hasAttachment       Boolean           @default(false) @map("has_attachment")
  recipientType       String            @default("practice") @map("recipient_type") @db.VarChar(50)
  assignedClinicianId String?           @map("assigned_clinician_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  messages            Message[]
  patientUser         User              @relation(fields: [patientUserId], references: [id], onDelete: Restrict)
  assignedClinician   ClinicianProfile? @relation("ClinicianAssignedThreads", fields: [assignedClinicianId], references: [id], onDelete: SetNull)

  @@index([patientUserId, updatedAt])
  @@index([assignedClinicianId, updatedAt])
  @@map("message_threads")
}

model Message {
  id         String        @id @default(uuid()) @db.Uuid
  threadId   String        @map("thread_id") @db.Uuid
  senderRole String        @map("sender_role") @db.VarChar(30)
  senderName String        @map("sender_name") @db.VarChar(150)
  body       String
  sentAt     DateTime      @default(now()) @map("sent_at")
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
  @@map("messages")
}

/// 0% APR Healthcare Financing Application
model FinancingApplication {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  treatmentCostPence Int      @map("treatment_cost_pence")
  durationMonths     Int      @map("duration_months")
  monthlyPence       Int      @map("monthly_pence")
  approvedLimitPence Int      @default(0) @map("approved_limit_pence")
  status             String   @default("pending") @db.VarChar(40)
  agreementRef       String   @unique @map("agreement_ref") @db.VarChar(60)
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("financing_applications")
}

/// Oral Health Rewards Ledger & Redemptions
model RewardRedemption {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  rewardId      String       @map("reward_id") @db.VarChar(50)
  rewardTitle   String       @map("reward_title") @db.VarChar(200)
  pointsCost    Int          @map("points_cost")
  voucherCode   String       @unique @map("voucher_code") @db.VarChar(40)
  redeemedAt    DateTime     @default(now()) @map("redeemed_at")
  /// Off a future deposit, for deposit vouchers.
  discountPence Int          @default(0) @map("discount_pence")
  /// The booking the voucher is on. It frees up again if that booking is cancelled.
  appointmentId String?      @unique @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, redeemedAt])
  @@map("reward_redemptions")
}

/// A patient's own code to share (decisions D-03). Made the first time they ask for it.
model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  code      String   @unique @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

/// Someone who signed up with another patient's code (D-03). When their first
/// completed visit costs over £150, the referrer gets a £25 voucher that staff
/// take off the referrer's next treatment bill at the practice.
model Referral {
  id                      String       @id @default(uuid()) @db.Uuid
  referrerUserId          String       @map("referrer_user_id") @db.Uuid
  /// One referrer per person.
  referredUserId          String       @unique @map("referred_user_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at")
  /// The completed visit that earned the voucher; null until one does.
  qualifyingAppointmentId String?      @unique @map("qualifying_appointment_id") @db.Uuid
  voucherCode             String?      @unique @map("voucher_code") @db.VarChar(20)
  voucherPence            Int?         @map("voucher_pence")
  voucherIssuedAt         DateTime?    @map("voucher_issued_at")
  voucherUsedAt           DateTime?    @map("voucher_used_at")
  voucherUsedById         String?      @map("voucher_used_by_id") @db.Uuid
  referrer                User         @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referred                User         @relation("Referred", fields: [referredUserId], references: [id], onDelete: Restrict)
  qualifyingAppointment   Appointment? @relation(fields: [qualifyingAppointmentId], references: [id], onDelete: SetNull)
  voucherUsedBy           User?        @relation("ReferralVoucherUsedBy", fields: [voucherUsedById], references: [id], onDelete: SetNull)

  @@index([referrerUserId])
  @@index([voucherUsedById])
  @@map("referrals")
}

/// Points earned for a completed visit: at most one award per appointment.
model RewardPointsAward {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  points        Int
  createdAt     DateTime    @default(now()) @map("created_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("reward_points_awards")
}

/// Patient Oral Health Metrics & Brushing Adherence
model OralHealthMetric {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  pointsBalance       Int      @default(0) @map("points_balance")
  streakDays          Int      @default(0) @map("streak_days")
  // Clinical measures are null until a clinician records them.
  plaqueIndexPercent  Int?     @map("plaque_index_percent")
  bleedingPercent     Int?     @map("bleeding_percent")
  recallDaysRemaining Int?     @map("recall_days_remaining")
  practitionerAdvice  String?  @map("practitioner_advice")
  weeklyBrushing      Json?    @map("weekly_brushing")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("oral_health_metrics")
}

enum UserRole {
  patient
  clinician
  operator
  admin
}

enum CareChannel {
  clinic
  van
  video
}

enum ServiceCategory {
  checkup
  hygiene
  emergency
  restorative
  cosmetic
}

/// A patient's request to be erased (UK GDPR Art. 17), worked by the DPO.
model ErasureRequest {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  source      String        @db.VarChar(30)
  status      ErasureStatus @default(pending)
  reason      String?       @db.VarChar(500)
  requestedAt DateTime      @default(now()) @map("requested_at")
  /// One calendar month after the request (Art. 12(3)).
  dueAt       DateTime      @map("due_at")
  completedAt DateTime?     @map("completed_at")
  handledById String?       @map("handled_by_id") @db.Uuid
  outcomeNote String?       @map("outcome_note") @db.VarChar(500)
  user        User          @relation("ErasureRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  handledBy   User?         @relation("ErasureRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, dueAt])
  @@map("erasure_requests")
}

enum ErasureStatus {
  pending
  completed
  rejected
}

enum AppointmentStatus {
  draft_hold
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum ToothCondition {
  healthy
  decay
  filled
  missing
  crown
  implant
  root_canal
}

enum VanShiftStatus {
  offline
  online
  paused
}

enum VanRequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
  in_progress
  completed
  no_show
}

enum VanStopPhase {
  queued
  en_route
  on_site
  in_treatment
  completed
  cancelled
  no_show
}
