# ==============================================================================
# PAV DENTAL BACKEND CONFIGURATION
# ==============================================================================

# Node Environment: "development" | "staging" | "production"
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 1. DATABASE & CACHE (Required)
# ------------------------------------------------------------------------------
# Local PostgreSQL database (matches docker-compose.yml)
DATABASE_URL="postgresql://pavdental:pavdental_secure_dev_password@localhost:5432/pavdental_db?schema=public"

# Local Redis instance (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. SECURITY, SESSIONS & AUDIT LOGGING (Required)
# ------------------------------------------------------------------------------
# Must be unique random strings of at least 32 characters in production/staging
JWT_ACCESS_SECRET="pavdental_dev_jwt_access_secret_super_secure_32chars_min"
JWT_REFRESH_SECRET="pavdental_dev_jwt_refresh_secret_super_secure_32chars_min"

# Key used to pseudonymise client IP addresses for NHS DSPT / HIPAA compliance
AUDIT_IP_HMAC_SECRET="pavdental_dev_audit_hmac_secret_super_secure_32chars_min"

# Allowed CORS origins (comma-separated, HTTPS required in production)
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000,http://localhost:19006,exp://localhost:8081"

# Mobile App Deep Link / Web Base URL (used in email links)
APP_URL="http://localhost:8081"

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS (Required for real deposit checkouts)
# Provider: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
# Secret Key: starts with sk_test_... (or sk_live_...)
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key

# Publishable Key: starts with pk_test_... (or pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key

# Webhook Signing Secret: starts with whsec_...
# Obtain via Stripe Dashboard -> Developers -> Webhooks, or via Stripe CLI:
# `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY (Transactional)
# Provider: https://postmarkapp.com (or fallback to console logs in dev)
# ------------------------------------------------------------------------------
# Server API token from Postmark Server -> Settings -> API Tokens
POSTMARK_SERVER_TOKEN=pm_server_token_replace_me

# Verified Sender Signature / Domain email address in Postmark
FROM_EMAIL="noreply@pavdental.com"

# ------------------------------------------------------------------------------
# 5. SMS & 2FA DELIVERY (Required for phone verification / SMS MFA)
# Provider: https://console.twilio.com
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token from Twilio Console
TWILIO_ACCOUNT_SID=AC_replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token

# Registered Twilio phone number in E.164 format (e.g. +447123456789 or +1234567890)
TWILIO_FROM_PHONE=+447000000000

# ------------------------------------------------------------------------------
# 6. DAILY.CO WEBRTC TELE-DENTISTRY (Required for live video consults)
# Provider: https://dashboard.daily.co/developers
# ------------------------------------------------------------------------------
# Daily.co API key from developer settings
DAILY_API_KEY=replace_with_daily_api_key

# Daily.co REST API base (default: https://api.daily.co/v1)
DAILY_DOMAIN=https://api.daily.co/v1

# ------------------------------------------------------------------------------
# 7. DOCUMENT VAULT & INTRAORAL PHOTO STORAGE (S3-Compatible Object Storage)
# Any S3-compatible provider works seamlessly:
#
# • Backblaze B2:
#   S3_ENDPOINT="https://s3.<region>.backblazeb2.com" (e.g. s3.eu-central-003.backblazeb2.com)
#   AWS_REGION="eu-central-003"
#
# • Tebi.io (Geo-distributed, 25GB free):
#   S3_ENDPOINT="https://s3.tebi.io"
#   AWS_REGION="global"
#
# • Cloudflare R2 (Zero egress fees):
#   S3_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
#   AWS_REGION="auto"
#
# • AWS S3 (Standard):
# S3_ENDPOINT=https://s3.tebi.io
# AWS_REGION=global
# AWS_ACCESS_KEY_ID=replace_with_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
# S3_BUCKET_NAME=pavdental-document-vault
# STORAGE_CDN_URL=https://cdn.pavdental.co.uk

# ------------------------------------------------------------------------------
# 8. CLINICAL RECORD ENCRYPTION (AWS KMS or Local AES-256-GCM)
# ------------------------------------------------------------------------------
KMS_KEY_ID=replace_with_kms_key_arn_or_id
ENCRYPTION_KEY=replace_with_32_byte_hex_key
