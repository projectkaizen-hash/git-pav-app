# ==============================================================================
# PAV DENTAL BACKEND CONFIGURATION
# ==============================================================================

# Node Environment: "development" | "test" | "staging" | "production" (required;
# any other value refuses to boot). Staging needs real Stripe test-mode keys and
# production needs live keys; mock and placeholder keys are rejected in both.
NODE_ENV=development
PORT=3000
# Number of proxy hops in front of the API (e.g. 1 behind a single load
# balancer). Required for per-IP rate limits to see real client addresses.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 1. DATABASE & CACHE (Required)
# ------------------------------------------------------------------------------
# Local PostgreSQL database (matches docker-compose.yml)
DATABASE_URL="postgresql://pavdental:pavdental_secure_dev_password@localhost:5432/pavdental_db?schema=public"

# Local Redis instance (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. SECURITY, SESSIONS & AUDIT LOGGING (Required)
# ------------------------------------------------------------------------------
# Must be unique random strings of at least 32 characters in production/staging
JWT_ACCESS_SECRET="pavdental_dev_jwt_access_secret_super_secure_32chars_min"
JWT_REFRESH_SECRET="pavdental_dev_jwt_refresh_secret_super_secure_32chars_min"

# Key used to pseudonymise client IP addresses for NHS DSPT / HIPAA compliance
AUDIT_IP_HMAC_SECRET="pavdental_dev_audit_hmac_secret_super_secure_32chars_min"

# Allowed CORS origins (comma-separated, HTTPS required in production)
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000,http://localhost:19006,exp://localhost:8081"

# Mobile App Deep Link / Web Base URL (used in email links). Production requires an https URL.
APP_URL="http://localhost:8081"

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS (Required for real deposit checkouts)
# Provider: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
# Secret Key: starts with sk_test_... (or sk_live_...)
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key

# Publishable Key: starts with pk_test_... (or pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key

# Webhook Signing Secret: starts with whsec_...
# Obtain via Stripe Dashboard -> Developers -> Webhooks, or via Stripe CLI:
# `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY (Transactional)
# Provider: https://postmarkapp.com (or fallback to console logs in dev)
# ------------------------------------------------------------------------------
# Server API token from Postmark Server -> Settings -> API Tokens. Required in production.
POSTMARK_SERVER_TOKEN=pm_server_token_replace_me

# Verified Sender Signature / Domain email address in Postmark
FROM_EMAIL="noreply@pavdental.com"

# ------------------------------------------------------------------------------
# 5. SMS & 2FA DELIVERY (Required for phone verification / SMS MFA)
# Provider: https://console.twilio.com
# ------------------------------------------------------------------------------
# Twilio Account SID & Auth Token from Twilio Console
TWILIO_ACCOUNT_SID=AC_replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token

# Registered Twilio phone number in E.164 format (e.g. +447123456789 or +1234567890)
TWILIO_FROM_PHONE=+447000000000

# ------------------------------------------------------------------------------
# 6. DAILY.CO WEBRTC TELE-DENTISTRY (Required for live video consults)
# Provider: https://dashboard.daily.co/developers
# ------------------------------------------------------------------------------
# Daily.co API key from developer settings. Required in production.
DAILY_API_KEY=replace_with_daily_api_key

# Daily.co REST API base (default: https://api.daily.co/v1)
DAILY_DOMAIN=https://api.daily.co/v1

# ------------------------------------------------------------------------------
# 7. DOCUMENT VAULT & INTRAORAL PHOTO STORAGE (S3-Compatible Object Storage)
# Any S3-compatible provider works seamlessly:
#
# • Backblaze B2:
#   S3_ENDPOINT="https://s3.<region>.backblazeb2.com" (e.g. s3.eu-central-003.backblazeb2.com)
#   AWS_REGION="eu-central-003"
#
# • Tebi.io (Geo-distributed, 25GB free):
#   S3_ENDPOINT="https://s3.tebi.io"
#   AWS_REGION="global"
#
# • Cloudflare R2 (Zero egress fees):
#   S3_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"
#   AWS_REGION="auto"
#
# • AWS S3 (Standard):
# S3_ENDPOINT=https://s3.tebi.io
# AWS_REGION=global
# AWS_ACCESS_KEY_ID=replace_with_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_secret_access_key
# S3_BUCKET_NAME=pavdental-document-vault   (required in production)
# STORAGE_CDN_URL=https://cdn.pavdental.co.uk

# ------------------------------------------------------------------------------
# 8. CLINICAL RECORD ENCRYPTION (local AES-256-GCM master key)
# ------------------------------------------------------------------------------
# ENCRYPTION_KEY is the master key. Records are wrapped under a key derived
# from it, and download links are signed with a separate derived key. Keep it
# in your secret store; losing it loses every encrypted gate code and note.
# KMS_KEY_ID is a label that versions the derived key. No AWS KMS call is made
# yet. Changing it is safe (old records still decrypt); afterwards run
# `npm run rewrap:encrypted -- --apply` to move them onto the new label.
# Changing AWS_REGION no longer affects encrypted data.
KMS_KEY_ID=replace_with_kms_key_arn_or_id
ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ------------------------------------------------------------------------------
# 9. VAN ETA ROUTING (Optional — real road travel times for van dispatch)
# ------------------------------------------------------------------------------
# Configure ONE provider. With neither set, ETAs fall back to the built-in
# haversine × urban-speed model (rough but functional).
#
# Mapbox Directions Matrix — https://account.mapbox.com/access-tokens/
# MAPBOX_TOKEN=pk.replace_with_mapbox_token
#
# OSRM Table service (self-hosted or a public instance)
# OSRM_BASE_URL=https://routing.example.com
#
# Tuning (defaults shown):
# VAN_ROUTING_TIMEOUT_MS=4000          per-request HTTP timeout
# VAN_ROUTING_CACHE_TTL_MS=120000      duration cache TTL (2 min)
# VAN_ROUTING_FAILURE_THRESHOLD=3      consecutive failures before breaker opens
# VAN_ROUTING_BREAKER_COOLDOWN_MS=60000  breaker open duration
#
# Live ETA re-push (push-notification cadence):
# ETA_PUSH_DRIFT_MINUTES=5            min ETA change (per patient) before notifying
# ETA_PUSH_THROTTLE_MINUTES=10        max one ETA push per patient per window

# ------------------------------------------------------------------------------
# PRIVATE PRESCRIPTIONS (signed PDFs)
# ------------------------------------------------------------------------------
# Ed25519 private key, base64 PKCS#8 DER. Generate with:
#   openssl genpkey -algorithm ed25519 -outform DER | base64
# Required in staging and production to issue prescriptions; development and
# test use a fixed built-in key.
# PRESCRIPTION_SIGNING_KEY=
# Practice details printed on every prescription.
PRACTICE_NAME="Pav Dental"
# PRACTICE_ADDRESS="<registered practice address>"
PRACTICE_PHONE="0800 1938 786"

# Retention (CS-23). Until this is "true" the daily sweep only reports what
# it would delete. Turn on once the owner approves the van location period.
RETENTION_ENFORCE="false"

# Error tracking (CS-44). Leave blank to turn it off. Events carry the error
# type, a scrubbed message, the stack and the request id; never request data.
SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"   # defaults to NODE_ENV
# SENTRY_RELEASE="<git sha>"
