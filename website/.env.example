# Admin Dashboard API Endpoint (Backend)
VITE_API_BASE_URL="http://localhost:3000"

# Google Analytics 4 Measurement ID
VITE_GA4_ID="G-XXXXXXXXXX"

# Optional: Neon Database URL (for direct server queries if applicable)
# DATABASE_URL="postgresql://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth configuration
VITE_AUTH_ENABLED="true"

