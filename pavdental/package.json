{
  "name": "pavdental",
  "version": "1.0.0",
  "description": "Pav Dental - Mobile Dental Care & Tele-Dentistry Platform",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.2",
    "@stripe/stripe-react-native": "^0.38.0",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.24",
    "expo-constants": "^57.0.19",
    "expo-font": "^57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-image": "^57.0.5",
    "expo-image-picker": "^57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "^57.0.10",
    "expo-local-authentication": "^57.0.3",
    "expo-location": "~57.0.19",
    "expo-notifications": "^57.0.20",
    "expo-router": "^57.0.22",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-mcp": "^0.2.4",
    "prettier": "^3.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx run-tests.ts",
    "test:account": "npx tsx src/__tests__/account.test.ts",
    "test:pricing": "npx tsx src/__tests__/booking.test.ts",
    "test:odontogram": "npx tsx src/__tests__/odontogram.test.ts",
    "test:routing": "npx tsx src/__tests__/auth-routing.test.ts",
    "test:clinical": "npx tsx src/__tests__/medical-summary.test.ts && npx tsx src/__tests__/prescription-normalize.test.ts",
    "check:content": "node scripts/check-fabricated-content.mjs",
    "test:booking": "npx tsx src/__tests__/uk-time.test.ts",
    "test:errors": "npx tsx src/__tests__/error-tracking.test.ts",
    "test:client": "npx tsx src/__tests__/api-client.test.ts",
    "test:states": "npx tsx src/__tests__/query-states.test.ts",
    "test:a11y": "npx tsx src/__tests__/accessibility.test.ts",
    "test:screens": "npx tsx src/__tests__/app-screens-truthfulness.test.ts",
    "test:routes": "npx tsx src/__tests__/duplicate-routes.test.ts",
    "test:lock": "npx tsx src/__tests__/biometric-lock.test.ts",
    "test:guards": "npx tsx src/__tests__/booking-guards.test.ts",
    "test:config": "npx tsx src/__tests__/build-config.test.ts",
    "test:dependants": "npx tsx src/__tests__/dependant-edits.test.ts",
    "test:screen-security": "npx tsx src/__tests__/screen-security.test.ts",
    "test:offline-notes": "npx tsx src/__tests__/offline-notes.test.ts",
    "test:all": "npm run test && npm run test:account && npm run test:pricing && npm run test:odontogram && npm run test:routing && npm run test:clinical && npm run test:booking && npm run test:errors && npm run test:client && npm run test:states && npm run test:a11y && npm run test:screens && npm run test:routes && npm run test:lock && npm run test:guards && npm run test:config && npm run test:dependants && npm run test:screen-security && npm run test:offline-notes && npm run check:content",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=228",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "private": true
}
