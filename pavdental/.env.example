# ==============================================================================
# PAV DENTAL MOBILE (EXPO REACT NATIVE) CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL
# ------------------------------------------------------------------------------
# In local development:
# - Use "http://localhost:3000" if running on iOS Simulator or Web.
# - Use "http://10.0.2.2:3000" if running on Android Emulator.
# - Use your computer's local Wi-Fi IP (e.g. "http://192.168.1.50:3000") if running on a physical phone.
# In staging/production: "https://api.pavdental.co.uk"
EXPO_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. STRIPE MOBILE PUBLISHABLE KEY
# Provider: https://dashboard.stripe.com/apikeys
# Starts with pk_test_... (or pk_live_...)
# NOTE: This is a placeholder - replace with your actual Stripe publishable key.
# For EAS builds set it per profile with `eas env:create` (not in eas.json).
# WARNING: Never commit real keys to version control
# ------------------------------------------------------------------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key

# ------------------------------------------------------------------------------
# 3. EAS PROJECT ID (CS-43)
# Not set yet: `eas init` writes the real one into app.json extra.eas.projectId
# once the Expo account exists. Can be overridden locally if needed:
# ------------------------------------------------------------------------------
EXPO_PUBLIC_EAS_PROJECT_ID=

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT MODE
# Controls Google Pay testEnv and debug capabilities: "development" | "preview" | "production"
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 5. ERROR TRACKING (SENTRY, CS-44)
# The project's DSN from Sentry > Settings > Client Keys. A DSN only lets the
# app send events, so it is safe in the app bundle. Leave blank to turn
# reporting off. Events are scrubbed: see src/lib/error-tracking.ts.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
