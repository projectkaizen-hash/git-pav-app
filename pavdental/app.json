{
  "expo": {
    "name": "Pav Dental",
    "slug": "pavdental",
    "version": "1.0.0",
    "scheme": "pavdental",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pavdental.app",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.pavdental.app"
        ]
      },
      "associatedDomains": [
        "applinks:pavdental.com",
        "applinks:staging.pavdental.com"
      ],
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.pavdental.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pavdental.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "pavdental.com",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "staging.pavdental.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "staging.pavdental.com",
              "pathPrefix": "/verify-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#0D9488"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0D9488"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pavdental.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Pav Dental to use your location to share the mobile dental van's live position with patients and navigate to visit addresses.",
          "locationAlwaysAndWhenInUsePermission": "During a van shift, Pav Dental shares the van's position with that day's patients even when the app is in the background, so their arrival times stay accurate. It stops when you end your shift.",
          "locationAlwaysPermission": "During a van shift, Pav Dental shares the van's position with that day's patients even when the app is in the background, so their arrival times stay accurate. It stops when you end your shift.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pav Dental needs photo library access so you can attach dental photos and clinical documents.",
          "cameraPermission": "Pav Dental uses the camera so you can take photos of your teeth to send to your dentist.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Pav Dental account"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
