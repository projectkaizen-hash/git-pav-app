# =============================================================================
# PavDental Admin Dashboard Environment Template (.env.example)
# Copy this file to .env.local and configure values.
# =============================================================================

# 1. Staff sign-in
# Staff sign in with their own Pav Dental app account (role admin). Point this
# at the app backend (git-pav-app/backend), e.g. http://localhost:3000.
PAV_API_URL=""
# Signs the dashboard's own session cookie. Use a long random value.
ADMIN_JWT_SECRET=""
# Only used when PAV_API_URL is blank: a single back-office login.
# ADMIN_PASSWORD_HASH is the hex sha256 of password + ADMIN_SALT.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_SALT=""

# 2. CORS & Website Origin
WEBSITE_ORIGIN="http://localhost:8080"

# 3. PostgreSQL Database
# Leave blank for local dev (uses embedded auto-migrated PGlite).
# Set for production Neon Postgres:
DATABASE_URL="postgresql://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 4. Email Delivery (Resend)
RESEND_API_KEY=""
CLINIC_NOTIFICATION_EMAIL="reception@pavdental.com"

# 5. Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""


# 6. Error tracking (Sentry, CS-44). Leave blank to turn it off. Events are
# scrubbed of request data and contact details (src/lib/error-scrub.ts).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
