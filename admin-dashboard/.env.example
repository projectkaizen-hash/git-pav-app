# =============================================================================
# PavDental Admin Dashboard Environment Template (.env.example)
# Copy this file to .env.local and configure values.
# =============================================================================

# 1. Admin Authentication
ADMIN_EMAIL="admin@pavdental.com"
ADMIN_PASSWORD="admin123"
ADMIN_JWT_SECRET="pavdental-secret-key-development-2026-secure-32chars"
ADMIN_PASSWORD_HASH=""
ADMIN_SALT=""

# 2. CORS & Website Origin
WEBSITE_ORIGIN="http://localhost:8080"

# 3. PostgreSQL Database
# Leave blank for local dev (uses embedded auto-migrated PGlite).
# Set for production Neon Postgres:
DATABASE_URL="postgresql://username:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 4. Email Delivery (Resend)
RESEND_API_KEY=""
CLINIC_NOTIFICATION_EMAIL="reception@pavdental.com"

# 5. Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

